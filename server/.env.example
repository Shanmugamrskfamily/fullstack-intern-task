# Copy to .env for local development. Every value is optional locally:
# without MONGODB_URI the API starts an in-memory MongoDB and seeds it.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (required in production)
MONGODB_URI=
MONGODB_DB_NAME=layora

# At least 32 random characters (required in production).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: regex for preview deployments, e.g. ^https://layora-[a-z0-9-]+\.vercel\.app$
CLIENT_ORIGIN_PATTERN=

# Public URL of this API, used to build absolute thumbnail URLs (Render sets RENDER_EXTERNAL_URL automatically)
PUBLIC_BASE_URL=

# Seed templates and the demo account on startup (safe to repeat)
SEED_ON_BOOT=true

# Optional: DNS servers for the mongodb+srv:// lookup. Set this only if start-up fails with
# "querySrv ECONNREFUSED" (a VPN or DNS filter refusing SRV queries), e.g. 8.8.8.8,1.1.1.1
DNS_SERVERS=
LOG_LEVEL=
