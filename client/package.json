{
  "name": "layora-web",
  "version": "1.0.0",
  "private": true,
  "description": "Layora web client: React 19 + Vite + Tailwind CSS v4 for the Mini SaaS Template Store",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
